# Linear Initiative Filter View Configuration
# Copy this file to config.toml and customize for your needs

[linear]
# Your Linear API token
# You can also set the LINEAR_API_TOKEN environment variable instead
# Get your token from: https://linear.app/settings/api
api_token = "lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Example 1: Using simplified SQL-like filter syntax (status filter)
[[views]]
title = "Active Initiatives"
filter = "status = 'Active' OR status = 'Planned'"

# Example 2: Using view ID instead of title + filter with status
[[views]]
view_id = "roadmap_abc123def456"
filter = "status = 'Active'"

# Example 3: Multiple conditions with AND (date range)
[[views]]
title = "Q1 2025 Initiatives"
filter = "startDate >= '2025-01-01' AND targetDate <= '2025-03-31'"

# Example 4: String matching with CONTAINS (searches name)
[[views]]
title = "Infrastructure Initiatives"
filter = "name CONTAINS 'Infrastructure' OR name CONTAINS 'Platform'"

# Example 5: Search in content field (markdown description from UI)
[[views]]
title = "Bucket A Initiatives"
filter = "content CONTAINS '#bucket:A'"

# Example 6: Complex filter with date and status
[[views]]
title = "Current Active Initiatives"
filter = "status = 'Active' AND startedAt <= '2025-11-15'"

# Supported filter operators:
# - Comparison: =, !=, >, >=, <, <=
# - String: CONTAINS, STARTS_WITH, ENDS_WITH
# - Logical: AND, OR, NOT
#
# Supported fields for INITIATIVES (note: priority is NOT supported for initiatives):
# - name: Initiative name (string)
# - status: Initiative status (string - case-sensitive!)
#     Valid values: 'Active', 'Planned', 'Completed'
# - startedAt: Started date (date string, e.g., '2025-01-01')
# - targetDate: Target date (date string, e.g., '2025-12-31')
# - description: Initiative short description (string, plain text)
# - content: Initiative full content (string, markdown format - what you see in UI)
#
# Note: 'priority' is only available on ISSUES, not initiatives.
# This tool filters initiatives, not issues.
#
# Fields requiring client-side filtering (fetch all initiatives then filter):
# - description, content, startedAt
# Other fields use Linear's native API filtering for better performance.
